OPENAI_API_KEY=
OPENAI_MISTAKE_MODEL=gpt-5.6-luna
# OPENAI_MISTAKE_TIMEOUT_MS=30000
# macOS defaults to CPU because these small recurrent batches are slower on MPS.
# REPLAY_ANALYSIS_DEVICE=cpu

# Required browser auth configuration from Supabase Project Settings > API.
# VITE_SUPABASE_URL must be the project URL (for example, https://PROJECT.supabase.co), not a dashboard URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase deployment values. SUPABASE_SECRET_KEY is server-only and must never use VITE_ or reach browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Configure both to run parsing and combined analysis through the SQS-backed AWS Lambdas.
# AWS_PROFILE=rrrocket
# AWS_REGION=us-east-2
# REPLAY_PARSER_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/ACCOUNT_ID/QUEUE_NAME
# Server-only Secrets Manager ID for private R2 credentials. Required by Lambda parsing and Supabase replay reads.
# REPLAY_PARSER_R2_SECRET_ID=rrrocket/dev/r2
# REPLAY_PARSER_TIMEOUT_MS=300000
# REPLAY_ANALYSIS_TIMEOUT_MS=900000
# REPLAY_PARSER_POLL_INTERVAL_MS=1000
# REPLAY_ANALYSIS_MODEL_VERSION=intent-gru-v2-c865b0f9-87a9bbea-0801f619
