    "@aws-sdk/client-sqs": "^3.883.0",
    "@aws-sdk/credential-providers": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.179.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
