{
  "name": "rocket-league-replay-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc --noEmit && vite build",
