{
  "framework": "vite",
  "buildCommand": "npm run vercel-build",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/check-player", "destination": "/index.html" },
    { "source": "/replay-history", "destination": "/index.html" },
    { "source": "/who-threw", "destination": "/index.html" }
  ]
}
